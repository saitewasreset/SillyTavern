# Environment Variables for SillyTavern with Nginx
# Copy this file to .env and adjust as needed

# === Node.js Environment ===
NODE_ENV=production
FORCE_COLOR=1

# === SillyTavern Configuration ===
# Enable Nginx proxy mode (required for this deployment)
USE_NGINX_PROXY=true

# Heartbeat interval in seconds (0 to disable)
SILLYTAVERN_HEARTBEATINTERVAL=30

# === Network Configuration ===
# External HTTP port (Nginx)
NGINX_PORT=8000

# Internal SillyTavern port (do not expose to host)
SILLYTAVERN_PORT=8000

# === Resource Limits ===
# Nginx memory limit
NGINX_MEMORY_LIMIT=256M
NGINX_MEMORY_RESERVATION=128M

# SillyTavern memory limit
# These limits help prevent the container from consuming too much memory
# Adjust based on your usage patterns and available system resources
SILLYTAVERN_MEMORY_LIMIT=256M
SILLYTAVERN_MEMORY_RESERVATION=128M

# === Logging ===
# Log level: error, warn, info, debug
LOG_LEVEL=info

# === Security ===
# Cloudflare ZeroTrust (if applicable)
# These are automatically passed by Cloudflare
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
